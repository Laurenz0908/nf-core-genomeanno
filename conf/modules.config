/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ABRICATE_RUN' {
        ext.args   = { "--db ${meta.db}" }
        ext.prefix = { "${meta.id}_${meta.db}" }
        publishDir = [
            path: { "${params.outdir}/abricate/reports" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ABRICATE_SUMMARY' {
        ext.prefix = { "summary_${meta.db}" }
        publishDir = [
            path: { "${params.outdir}/abricate/summary" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'GTDBTK_CLASSIFYWF' {
        ext.args   = [
            "--extension ${params.fasta_extension}",
            params.gtdbtk_skip_aniscreen ? "--skip_ani_screen" : "",
        ].join(' ').trim()
        publishDir = [
            path: { "${params.outdir}/gtdbtk" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    
    withName: 'EXTRACT_CLOSE_REFS' {
        ext.max_refs = { params.primer_max_refs ?: 20 }
        ext.min_ani  = { params.primer_min_ani  ?: 80.0 }
        publishDir = [
            path: { "${params.outdir}/primer_design/${meta.id}/refs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'NUCMER' {
        ext.args   = '--maxmatch'
        ext.prefix = { "${meta.id}_vs_${meta.ref_name}" }
        publishDir = [
            enabled: false       // intermediate output, don't publish
        ]
    }

    withName: 'COORDS_TO_BED' {
        ext.min_identity   = 80.0
        ext.min_aln_length = 100
        ext.prefix = { "${meta.id}_vs_${meta.ref_name}" }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'DESIGN_STRAIN_PRIMERS' {
        ext.min_unique_length = { params.primer_min_unique_len ?: 200 }
        ext.primer_opt_tm     = { params.primer_opt_tm         ?: 60.0 }
        ext.primer_min_tm     = { params.primer_min_tm         ?: 57.0 }
        ext.primer_max_tm     = { params.primer_max_tm         ?: 63.0 }
        ext.primer_min_gc     = 40.0
        ext.primer_max_gc     = 60.0
        ext.product_size_min  = { params.primer_product_min    ?: 150 }
        ext.product_size_max  = { params.primer_product_max    ?: 500 }
        ext.num_primer_pairs  = 3
        publishDir = [
            path: { "${params.outdir}/primer_design/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BLAST_VALIDATE_PRIMERS' {
        publishDir = [
            path: { "${params.outdir}/primer_design/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}
